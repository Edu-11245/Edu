rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // غيّر الإيميل ده لإيميل المعلمة اللي بتدخل بيه /admin.html
    function isAdmin() { return request.auth != null && request.auth.token.email == 'school@example.com'; }
    function signedIn() { return request.auth != null; }
    function enrolled(uid, key) { return exists(/databases/$(database)/documents/enrollments/$(uid + '_' + key)); }

    match /settings/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /courses/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /lectures/{id}  { allow read: if true; allow write: if isAdmin(); }

    // لينك الفيديو: للأدمن، أو لطالب مشترك (في الحصة أو الكورس)، أو حصة مجانية لأي طالب مسجّل
    match /videos/{id} {
      allow get: if isAdmin() || (signedIn() && (resource.data.free == true
                    || enrolled(request.auth.uid, id) || enrolled(request.auth.uid, resource.data.courseId)));
      allow list, write: if isAdmin();
    }

    // أكواد الحصص (اسم الـ document هو الكود): طالب مسجّل يقدر يجيب كود بعينه، مايقدرش يعرض القائمة
    match /unlock/{code} { allow get: if signedIn(); allow list, write: if isAdmin(); }

    match /students/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
                    && request.resource.data.nationalId.matches('^[23][0-9]{13}$')
                    && request.resource.data.name is string && request.resource.data.name.size() < 100;
      allow read: if isAdmin() || request.auth.uid == uid;
      allow update: if request.auth.uid == uid && request.resource.data.nationalId == resource.data.nationalId;
      allow update, delete: if isAdmin();
    }

    match /requests/{id} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'pending';
      allow read: if isAdmin() || resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /enrollments/{id} { allow read: if isAdmin() || resource.data.uid == request.auth.uid; allow write: if isAdmin(); }

    match /views/{id} {
      allow create, update: if signedIn() && request.resource.data.uid == request.auth.uid
                            && id == request.auth.uid + '_' + request.resource.data.lectureId;
      allow read: if isAdmin();
    }
  }
}
