{
  "rules": {
    "config": { ".read": false, ".write": false },

    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid && newData.exists()",
        ".validate": "newData.hasChildren(['role','name','email'])",
        "role": { ".validate": "(data.exists() && data.val() === newData.val()) || (!data.exists() && (newData.val() === 'student' || (newData.val() === 'teacher' && root.child('config/teacherCode').exists() && newData.parent().child('code').val() === root.child('config/teacherCode').val())))" },
        "name": { ".validate": "newData.isString() && newData.val().length > 1 && newData.val().length < 100" },
        "email": { ".validate": "newData.isString() && newData.val().length < 150" },
        "phone": { ".validate": "newData.isString() && newData.val().length < 30" },
        "title": { ".validate": "newData.isString() && newData.val().length < 100" },
        "code": { ".validate": "newData.isString() && newData.val().length < 60" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "teachers": {
      ".read": "auth != null",
      "$tid": {
        ".write": "auth != null && auth.uid === $tid && root.child('users/' + auth.uid + '/role').val() === 'teacher' && newData.exists()",
        ".validate": "newData.hasChildren(['name'])",
        "name": { ".validate": "newData.isString() && newData.val().length > 1 && newData.val().length < 100" },
        "title": { ".validate": "newData.isString() && newData.val().length < 100" },
        "bio": { ".validate": "newData.isString() && newData.val().length < 800" },
        "photo": { ".validate": "newData.isString() && newData.val().length < 200000" },
        "pay": { ".validate": "true" },
        "$other": { ".validate": false }
      }
    },

    "courses": {
      ".read": "auth != null",
      "$cid": {
        ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'teacher' && ((!data.exists() && newData.child('teacherId').val() === auth.uid) || (data.exists() && data.child('teacherId').val() === auth.uid && (!newData.exists() || newData.child('teacherId').val() === auth.uid)))",
        ".validate": "newData.hasChildren(['teacherId','title'])",
        "teacherId": { ".validate": "newData.isString()" },
        "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 150" },
        "description": { ".validate": "newData.isString() && newData.val().length < 1500" },
        "image": { ".validate": "newData.isString() && newData.val().length < 250000" },
        "position": { ".validate": "newData.isNumber()" },
        "createdAt": { ".validate": "newData.isNumber()" },
        "$other": { ".validate": false }
      }
    },

    "lectures": {
      "$cid": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('courses/' + $cid + '/teacherId').val() === auth.uid",
        "$lid": {
          ".validate": "newData.hasChildren(['title','price'])",
          "title": { ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length < 150" },
          "description": { ".validate": "newData.isString() && newData.val().length < 600" },
          "price": { ".validate": "newData.isNumber() && newData.val() >= 0" },
          "position": { ".validate": "newData.isNumber()" },
          "createdAt": { ".validate": "newData.isNumber()" },
          "$other": { ".validate": false }
        }
      }
    },

    "videos": {
      "$cid": {
        ".read": "auth != null && root.child('courses/' + $cid + '/teacherId').val() === auth.uid",
        "$lid": {
          ".read": "auth != null && (root.child('courses/' + $cid + '/teacherId').val() === auth.uid || data.child('free').val() === true || root.child('enrollments/' + auth.uid + '/' + $cid).exists() || root.child('enrollments/' + auth.uid + '/' + $lid).exists())",
          ".write": "auth != null && root.child('courses/' + $cid + '/teacherId').val() === auth.uid",
          ".validate": "newData.hasChildren(['url'])",
          "url": { ".validate": "newData.isString() && newData.val().length < 1000" },
          "free": { ".validate": "newData.isBoolean()" },
          "code": { ".validate": "newData.isString() && newData.val().length < 20" },
          "$other": { ".validate": false }
        }
      }
    },

    "unlock": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && ((newData.exists() && root.child('courses/' + newData.child('courseId').val() + '/teacherId').val() === auth.uid) || (!newData.exists() && root.child('courses/' + data.child('courseId').val() + '/teacherId').val() === auth.uid))",
        ".validate": "newData.hasChildren(['courseId','lectureId','url'])",
        "courseId": { ".validate": "newData.isString()" },
        "lectureId": { ".validate": "newData.isString()" },
        "url": { ".validate": "newData.isString() && newData.val().length < 1000" },
        "$other": { ".validate": false }
      }
    },

    "enrollments": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$key": {
          ".write": "auth != null && root.child('users/' + auth.uid + '/role').val() === 'teacher' && ((newData.exists() && newData.child('teacherId').val() === auth.uid && root.child('courses/' + newData.child('courseId').val() + '/teacherId').val() === auth.uid) || (!newData.exists() && data.child('teacherId').val() === auth.uid))",
          ".validate": "newData.hasChildren(['teacherId','courseId'])"
        }
      }
    },

    "requests": {
      "$tid": {
        ".read": "auth != null && auth.uid === $tid",
        "$rid": {
          ".write": "auth != null && ((!data.exists() && newData.child('uid').val() === auth.uid && newData.child('teacherId').val() === $tid && newData.child('status').val() === 'pending' && root.child('teachers/' + $tid).exists()) || (data.exists() && auth.uid === $tid))",
          ".validate": "newData.hasChildren(['uid','teacherId','status','title'])",
          "status": { ".validate": "newData.val() === 'pending' || newData.val() === 'approved' || newData.val() === 'rejected'" },
          "title": { ".validate": "newData.isString() && newData.val().length < 200" },
          "amount": { ".validate": "newData.isNumber() && newData.val() >= 0" }
        }
      }
    },

    "studentRequests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$rid": {
          ".write": "auth != null && ((auth.uid === $uid && !data.exists() && newData.child('status').val() === 'pending') || (data.exists() && data.child('teacherId').val() === auth.uid))",
          ".validate": "newData.hasChildren(['teacherId','status','title'])"
        }
      }
    },

    "receipts": {
      "$rid": {
        ".read": "auth != null && (data.child('uid').val() === auth.uid || data.child('teacherId').val() === auth.uid)",
        ".write": "auth != null && !data.exists() && newData.child('uid').val() === auth.uid",
        ".validate": "newData.hasChildren(['uid','teacherId','img']) && newData.child('img').isString() && newData.child('img').val().length < 450000"
      }
    },

    "views": {
      "$tid": {
        ".read": "auth != null && auth.uid === $tid",
        "$key": {
          ".write": "auth != null && $key.beginsWith(auth.uid + '_') && newData.child('uid').val() === auth.uid && newData.child('teacherId').val() === $tid",
          ".validate": "newData.hasChildren(['uid','teacherId','count'])",
          "count": { ".validate": "newData.isNumber()" }
        }
      }
    }
  }
}
